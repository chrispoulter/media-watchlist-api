{
    "name": "media-watchlist-api",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/src/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint --cache .",
        "format": "prettier --write .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "email:dev": "email dev -p 3001 -d src/emails"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "@hono/zod-openapi": "^1.6.3",
        "@logtape/drizzle-orm": "^2.3.6",
        "@logtape/hono": "^2.2.8",
        "@logtape/logtape": "^2.3.5",
        "@logtape/redaction": "^2.3.6",
        "@scalar/hono-api-reference": "^0.12.2",
        "better-auth": "^1.6.23",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.8",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-email": "^6.6.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1"
    }
}
