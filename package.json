{
    "name": "media-watchlist-api",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/src/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint --cache .",
        "format": "prettier --write .",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "email:dev": "email dev -p 3001 -d src/emails",
        "vercel-build": "tsx src/db/migrate.ts"
    },
    "dependencies": {
        "@react-email/ui": "^6.6.5",
        "@scalar/express-api-reference": "^0.10.7",
        "better-auth": "^1.6.23",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-email": "^6.6.5",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.0.1",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.20.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "jiti": "^2.7.0",
        "openapi-types": "^12.1.3",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.4",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1"
    }
}
